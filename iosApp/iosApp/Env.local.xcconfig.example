// Modèle de Env.local.xcconfig — variables d'environnement iOS non commitées.
//
// 1. cp Env.local.xcconfig.example Env.local.xcconfig
// 2. Renseigner les valeurs ci-dessous ; Env.local.xcconfig est ignoré par
//    Git (.gitignore) et chargé par Env.xcconfig (attaché aux configs Debug
//    et Release de la cible iosApp) — aucun réglage Xcode à retoucher.
//
// Valeur vide ou clé absente = réglage par défaut du code : URLs zesit.fr,
// token TI non configuré (hint rouge du panneau Traffic, pas d'appel réseau).
// L'environnement du process (variables du schéma de run) reste prioritaire.
//
// ⚠ En xcconfig « // » démarre un commentaire : écrire les URLs avec la
// variable SLASH d'Env.xcconfig (définie avant l'include ci-dessous).

// Token traffic-inspector (/ti-api), fourni par l'environnement — secret
// installé dans les secrets de l'app (SecretsStore) au lancement.
TI_API_TOKEN =

// Token security-scanner (/sc-api, panneau « Sécurité »), même mécanique.
SC_API_TOKEN =

// Surcharges des URLs par défaut des panneaux de connexion (facultatif) :
// KPI_BASE_URL = https:$(SLASH)/kpi.zesit.fr
// NTFY_BASE_URL = https:$(SLASH)/ntfy.zesit.fr
// TRAFFIC_BASE_URL = https:$(SLASH)/traffic.zesit.fr
// SECURITY_BASE_URL = https:$(SLASH)/security.zesit.fr
