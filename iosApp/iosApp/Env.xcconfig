// Variables d'environnement de l'app iOS (attachée à la cible iosApp en
// Debug et Release). Elles sont figées dans l'Info.plist du .app via des
// clés $(TI_API_TOKEN)/$(KPI_BASE_URL)/… lues par EnvFactory.ios.
//
// Les valeurs réelles (secrets) ne sont JAMAIS commitées : elles vivent dans
// Env.local.xcconfig — chargé en option ci-dessous (#include? : le build
// fonctionne aussi s'il est absent ; à répliquer depuis
// Env.local.xcconfig.example).
// L'environnement du process (variables du schéma de run) reste prioritaire
// sur ces valeurs build-time.

// En xcconfig, « // » démarre un commentaire : une URL ne s'y écrit pas telle
// quelle (https://… serait tronqué en « https: ») — on interpole cette
// variable : https:$(SLASH)/kpi.zesit.fr
SLASH = /

// Défauts vides : évitent que l'Info.plist fige le littéral « $(VAR) ».
TI_API_TOKEN =
SC_API_TOKEN =
NTFY_TOKEN =
KPI_BASE_URL =
NTFY_BASE_URL =
TRAFFIC_BASE_URL =
SECURITY_BASE_URL =

// Valeurs locales (non commitées) — dernier mot.
#include? "Env.local.xcconfig"
